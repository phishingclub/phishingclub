FROM debian:12-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

# install ca-certificates, tzdata, and Chromium runtime dependencies.
# The Chromium binary is auto-downloaded by rod at first use; these shared
# libraries must already be present or it will fail to start.
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        tzdata \
        libglib2.0-0 \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libasound2 \
        libpango-1.0-0 \
        libcairo2 \
        fonts-liberation \
        fonts-noto-color-emoji \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxext6 \
        tini=0.19.0-1+b3 \
    && rm -rf /var/lib/apt/lists/*

# create non-root user
RUN groupadd -g 1000 appuser && \
    useradd -r -u 1000 -g appuser appuser

# set working directory
WORKDIR /app

# copy the binary from build context based on target architecture
ARG TARGETARCH
COPY build/${TARGETARCH}/phishingclub /app/phishingclub

# make binary executable and set ownership
RUN chmod +x /app/phishingclub && \
    chown appuser:appuser /app/phishingclub

# copy entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# expose ports (using non-privileged ports by default)
EXPOSE 8080 8443 8000

# tini runs as PID 1 and reaps exited processes. The report browser leaves
# helper processes (such as the crash handler) that are handed to PID 1 when
# they exit, and without a reaper they stay as zombies. -s also makes tini
# reap them when it is not PID 1, for example under docker run --init or
# compose init: true.
ENTRYPOINT ["/usr/bin/tini", "-s", "--", "/entrypoint.sh"]
